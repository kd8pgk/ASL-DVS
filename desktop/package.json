{
  "name": "nodecontroller-desktop",
  "productName": "Node Controller Desktop",
  "version": "0.11.16",
  "description": "Desktop client for Node Controller and Node Talker pages",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "smoke": "node test/smoke.js",
    "dist": "electron-builder --linux AppImage --publish never",
    "check-package": "node test/package.js"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "electron": "44.11.5",
    "electron-builder": "26.18.0"
  },
  "author": "kd8pgk",
  "license": "SEE LICENSE IN ../LICENSE",
  "build": {
    "appId": "io.github.kd8pgk.nodecontroller",
    "productName": "Node Controller Desktop",
    "copyright": "kd8pgk",
    "asar": true,
    "electronLanguages": [
      "en-US"
    ],
    "files": [
      "src/**/*",
      "ui/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Network",
      "artifactName": "NodeController-${version}.${ext}",
      "executableName": "nodecontroller",
      "syncDesktopName": true
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": true
    },
    "publish": null,
    "compression": "normal"
  },
  "desktopName": "nodecontroller.desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/kd8pgk/ASL-DVS.git",
    "directory": "desktop"
  }
}
