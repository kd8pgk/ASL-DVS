<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/error"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/error_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/text"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            tools:ignore="ButtonStyle">

            <Button
                android:id="@+id/retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/accent"
                android:minHeight="48dp"
                android:text="@string/retry"
                android:textColor="@color/accent_ink" />

            <Button
                android:id="@+id/back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:minHeight="48dp"
                android:text="@string/back" />
        </LinearLayout>
    </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/tabbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bar"
        android:orientation="vertical"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/line" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingTop="4dp"
            android:paddingEnd="6dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:id="@+id/tab_connect"
                style="@style/TabCell">

                <ImageView
                    style="@style/TabIcon"
                    android:src="@drawable/ic_tab_connect" />

                <TextView
                    style="@style/TabLabel"
                    android:text="@string/tab_connect" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tab_listen"
                style="@style/TabCell">

                <ImageView
                    style="@style/TabIcon"
                    android:src="@drawable/ic_tab_listen" />

                <TextView
                    style="@style/TabLabel"
                    android:text="@string/tab_listen" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tab_setup"
                style="@style/TabCell">

                <ImageView
                    style="@style/TabIcon"
                    android:src="@drawable/ic_tab_setup" />

                <TextView
                    style="@style/TabLabel"
                    android:text="@string/tab_setup" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
