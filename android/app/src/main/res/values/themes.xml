<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NodeTalker" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/bar</item>
        <item name="android:colorPrimaryDark">@color/bar</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:navigationBarColor">@color/bar</item>
        <item name="android:statusBarColor">@color/bar</item>
    </style>

    <style name="TabCell">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="TabIcon">
        <item name="android:layout_width">22dp</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="TabLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
